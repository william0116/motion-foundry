{
  "name": "motion-foundry",
  "private": true,
  "description": "A browser-based motion graphics workbench with local GIF and transparent PNG export.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs && prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/gif-export.test.cjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "prettier": "3.9.6"
  }
}
